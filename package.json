{
  "name": "phlynx",
  "description": "A web-based graphical interface for coupling existing CellML components into a single system model.",
  "author": {
    "name": "Hugh Sorby",
    "email": "h.sorby@auckland.ac.nz"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/physiomelinks/phlynx.git"
  },
  "contributors": [
    {
      "name": "Jarrah Dowrick"
    },
    {
      "name": "Finbar Argus"
    }
  ],
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "main": "src/electron/main.js",
  "scripts": {
    "dev": "yarn build:glossary && vite",
    "build": "yarn build:glossary && vite build",
    "app:dev": "yarn build:glossary && vite --config vite.electron.config.js",
    "app:pack": "yarn build:glossary && vite build --config vite.electron.config.js && electron-builder --dir",
    "app:build": "yarn build:glossary && vite build --config vite.electron.config.js && electron-builder",
    "build:glossary": "node src/services/generate/generateGlossaryIndex.js",
    "preview": "yarn build:glossary && vite preview",
    "update:docs:changelog": "node scripts/build-changelog.js",
    "docs:screenshots": "python3 tests/playwright/docs_screenshots.py",
    "test": "vitest",
    "test:ui": "python3 tests/run_playwright_tests.py",
    "test:unit": "vitest run --dir tests/vitest/",
    "test:coverage": "vitest --coverage"
  },
  "build": {
    "appId": "nz.ac.auckland.physiome-links.phlynx",
    "productName": "Physiome Links",
    "files": [
      "dist-electron/**/*",
      "dist/**/*",
      "src/electron/main.js"
    ],
    "directories": {
      "output": "dist-applications"
    }
  },
  "dependencies": {
    "@celldl/editor": "https://github.com/physiomelinks/CellDLEditorComponent/releases/download/phlynx-v0.20261007.0-phlynx.20/celldl-editor-0.20261007.0-phlynx.20.tgz",
    "@codemirror/language": "^6.13.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@dagrejs/dagre": "^3.1.3",
    "@lezer/highlight": "^1.2.5",
    "@lezer/lr": "^1.4.12",
    "@opencor/libopencor": "^1.20261113.0",
    "@physiomelinks/bg2cellml": "0.6.2",
    "@physiomelinks/math-ast": "0.6.2",
    "@physiomelinks/protocol-kit": "^0.6.0",
    "@physiomelinks/steady-state": "file:./vendor/physiomelinks-steady-state-0.0.0.tgz",
    "@primeuix/utils": "^0.6.4",
    "@primevue/themes": "4",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "@vue-flow/node-resizer": "^1.5.1",
    "@vue/devtools-api": "^8.2.1",
    "@xmldom/xmldom": "0.9.12",
    "cellml-text-editor": "^0.7.1",
    "codemirror": "^6.0.2",
    "cytoscape": "^3.35.0",
    "cytoscape-fcose": "^2.2.0",
    "elkjs": "^0.12.1",
    "github-markdown-css": "^5.9.0",
    "html-to-image": "^1.11.13",
    "htmlparser2": "^12.0.0",
    "jszip": "^3.10.2",
    "katex": "^0.17.0",
    "libcellml.js": "0.7.2",
    "oxigraph": "0.5.13",
    "papaparse": "^5.7.1",
    "pinia": "^4.1.0",
    "primeicons": "^7.0.0",
    "primevue": "4",
    "sass-embedded": "^1.108.2",
    "semver": "^7.8.6",
    "uplot": "1.6.32",
    "vue": "3.5.45",
    "vue-codemirror": "^6.1.1",
    "vue-router": "^5.5.1",
    "vue3-libcellml.js": "^0.7.1",
    "vue3-math-editor": "^0.3.5"
  },
  "devDependencies": {
    "@hsorby/changelog": "patch:@hsorby/changelog@npm%3A3.0.3#~/.yarn/patches/@hsorby-changelog-npm-3.0.3-fa30fc0b80.patch",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/compiler-dom": "3.5.45",
    "@vue/test-utils": "^2.6.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "happy-dom": "^21.0.4",
    "markdown-it": "^15.0.3",
    "markdown-it-attrs": "^5.0.1",
    "markdown-it-github-alerts": "^1.0.1",
    "markdown-it-link-attributes": "^4.0.1",
    "rollup-plugin-visualizer": "^7.1.3",
    "tailwindcss": "^4.3.5",
    "tailwindcss-primeui": "^0.6.1",
    "unplugin-vue-markdown": "^32.1.1",
    "vite": "^8.3.8",
    "vite-plugin-electron": "^1.2.0",
    "vitest": "^5.1.0"
  },
  "packageManager": "yarn@4.18.1",
  "changelog": {
    "labels": {
      "uncategorized": "Not Specified",
      "breaking": "Breaking Changes",
      "feature": "New Features",
      "bug": "Fixed Bugs",
      "documentation": "Documentation Updates",
      "maintenance": "Maintenance Work"
    },
    "cacheDir": ".changelog"
  }
}
