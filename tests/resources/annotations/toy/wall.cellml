<?xml version="1.0" encoding="UTF-8"?>
<!-- The toy membrane, as the vitest toy declares it, charged by the summed charge flow. -->
<model xmlns="http://www.cellml.org/cellml/2.0#" xmlns:cellml="http://www.cellml.org/cellml/2.0#" name="ToyWall">
  <component name="wall">
    <variable name="t" units="second" interface="public"/>
    <variable name="u" units="J_per_C" initial_value="0" interface="public"/>
    <variable name="i_tot" units="fmol_per_mm2_per_s" interface="public"/>
    <variable name="C_m" units="toy_capacitance" initial_value="1"/>
    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply><eq/>
        <apply><diff/><bvar><ci>t</ci></bvar><ci>u</ci></apply>
        <apply><divide/><ci>i_tot</ci><ci>C_m</ci></apply>
      </apply>
    </math>
  </component>
</model>
