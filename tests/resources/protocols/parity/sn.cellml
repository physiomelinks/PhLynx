        </apply>
      </apply>
      <!-- This has changed a lot from the Belluzi paper. Double check with Harvey's data.-->
      <apply>
        <eq/>
        <ci>tau_c</ci>
        <apply>
          <plus/>
          <ci>tau_c_min</ci>
          <apply>
            <divide/>
            <apply>
              <minus/>
              <ci>tau_c_max</ci>
              <ci>tau_c_min</ci>
            </apply>
            <apply>
              <plus/>
              <cn cellml:units="dimensionless">1</cn>
              <apply>
                <exp/>
