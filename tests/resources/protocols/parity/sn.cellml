      <apply>
        <eq/>
        <ci>c_inf</ci>
        <apply>
          <divide/>
          <cn cellml:units="dimensionless">1</cn>
          <apply>
            <plus/>
            <cn cellml:units="dimensionless">1</cn>
            <apply>
              <exp/>
              <apply>
                <divide/>
                <apply>
                  <minus/>
                  <apply>
                    <plus/>
