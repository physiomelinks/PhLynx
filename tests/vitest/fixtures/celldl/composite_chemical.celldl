<svg xmlns="http://www.w3.org/2000/svg" viewBox="-140 -40 450 80"><metadata id="celldl-rdf-metadata" data-content-type="text/turtle"><![CDATA[@prefix : <#> .
@prefix bgf: <https://bg-rdf.org/ontologies/bondgraph-framework#> .
@prefix cdt: <https://w3id.org/cdt/> .
@prefix celldl: <http://celldl.org/ontologies/celldl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

# Drawn in the CellDL editor: a reaction A -> B whose two species are chemical storage composite nodes
# (the editor lists them as both bond elements and junctions).
#
#     q_A_cell (ChemicalStorageNode) --> 1 --> Rx_r_cell (ChemicalReaction) --> 1 --> q_B_cell (ChemicalStorageNode)

<> a celldl:Document, bgf:BondgraphModel ;
  dcterms:created "2026-10-21T22:22:51.447Z" ;
  dcterms:modified "2026-10-21T22:23:36.212Z" ;
  owl:versionInfo "1.0" ;
  bgf:hasBondElement :ID-00000001, :ID-00000003, :ID-00000005 ;
  bgf:hasJunctionStructure :ID-00000001, :ID-00000002, :ID-00000004, :ID-00000005 .

:ID-00000001 a celldl:Component, bgf:ChemicalStorageNode ;
  bgf:hasLocation "cell" ;
  bgf:hasSpecies "A" ;
  bgf:hasSymbol "q" ;
  bgf:hasValue "2 mol"^^cdt:ucum ;
  bgf:parameterValue [
    bgf:hasValue "1 mol-1"^^cdt:ucum ;
    bgf:varName "K"
  ] .

:ID-00000002 a celldl:Component, bgf:OneNode ;
  bgf:hasLocation "cell" ;
  bgf:hasSpecies "A" ;
  bgf:hasSymbol "v" .

:ID-00000003 a celldl:Component, bgf:ChemicalReaction ;
  bgf:hasLocation "cell" ;
  bgf:hasSpecies "r" ;
  bgf:hasSymbol "Rx" ;
  bgf:parameterValue [
    bgf:hasValue "0.5 mol/s"^^cdt:ucum ;
    bgf:varName "kappa"
  ] .

:ID-00000004 a celldl:Component, bgf:OneNode ;
  bgf:hasLocation "cell" ;
  bgf:hasSpecies "B" ;
  bgf:hasSymbol "v" .

:ID-00000005 a celldl:Component, bgf:ChemicalStorageNode ;
  bgf:hasLocation "cell" ;
  bgf:hasSpecies "B" ;
  bgf:hasSymbol "q" ;
  bgf:hasValue "0 mol"^^cdt:ucum ;
  bgf:parameterValue [
    bgf:hasValue "1 mol-1"^^cdt:ucum ;
    bgf:varName "K"
  ] .

:ID-00000006 a celldl:Connection ;
  celldl:hasSource :ID-00000001 ;
  celldl:hasTarget :ID-00000002 ;
  bgf:hasSource :ID-00000001 ;
  bgf:hasTarget :ID-00000002 .

:ID-00000007 a celldl:Connection ;
  celldl:hasSource :ID-00000002 ;
  celldl:hasTarget :ID-00000003 ;
  bgf:hasSource :ID-00000002 ;
  bgf:hasTarget :ID-00000003 .

:ID-00000008 a celldl:Connection ;
  celldl:hasSource :ID-00000003 ;
  celldl:hasTarget :ID-00000004 ;
  bgf:hasSource :ID-00000003 ;
  bgf:hasTarget :ID-00000004 .

:ID-00000009 a celldl:Connection ;
  celldl:hasSource :ID-00000004 ;
  celldl:hasTarget :ID-00000005 ;
  bgf:hasSource :ID-00000004 ;
  bgf:hasTarget :ID-00000005 .
]]></metadata><defs id="celldl-svg-definitions"><style id="celldl-svg-stylesheet">svg{font-size:16px}.celldl-Connection{stroke-linejoin:round;fill:none}.celldl-Compartment&gt;rect.compartment{fill:#CCC;opacity:0.6;stroke:#444;rx:10px;ry:10px}.celldl-InterfacePort{fill:red;r:4px}.celldl-Unconnected{fill:red;fill-opacity:0.1;stroke:red;r:4px}.celldl-Connection.bondgraph.arrow { marker-end:url(#connection-end-arrow-bondgraph) }
