<svg xmlns="http://www.w3.org/2000/svg" viewBox="-140 -40 260 80"><metadata id="celldl-rdf-metadata" data-content-type="text/turtle"><![CDATA[@prefix : <#> .
@prefix bgf: <https://bg-rdf.org/ontologies/bondgraph-framework#> .
@prefix cdt: <https://w3id.org/cdt/> .
@prefix celldl: <http://celldl.org/ontologies/celldl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

# Drawn in the CellDL editor: two capacitors joined through a resistor, each a composite node (the
# editor lists them as both bond elements and junctions).
#
#     q_A_circ (ElectricalCapacitiveNode) --> v_R_circ (ElectricalResistiveNode) --> q_B_circ (ElectricalCapacitiveNode)

<> a celldl:Document, bgf:BondgraphModel ;
  dcterms:created "2026-10-21T22:22:12.574Z" ;
  dcterms:modified "2026-10-21T22:22:43.193Z" ;
  owl:versionInfo "1.0" ;
  bgf:hasBondElement :ID-00000001, :ID-00000002, :ID-00000003 ;
  bgf:hasJunctionStructure :ID-00000001, :ID-00000002, :ID-00000003 .

:ID-00000001 a celldl:Component, bgf:ElectricalCapacitiveNode ;
  bgf:hasLocation "circ" ;
  bgf:hasSpecies "A" ;
  bgf:hasSymbol "q" ;
  bgf:hasValue "1 C"^^cdt:ucum ;
  bgf:parameterValue [
    bgf:hasValue "0.001 C2/J"^^cdt:ucum ;
    bgf:varName "C"
  ] .

:ID-00000002 a celldl:Component, bgf:ElectricalResistiveNode ;
  bgf:hasLocation "circ" ;
  bgf:hasSpecies "R" ;
  bgf:hasSymbol "v" ;
  bgf:parameterValue [
    bgf:hasValue "1000 J.s.C-2"^^cdt:ucum ;
    bgf:varName "R"
  ] .

:ID-00000003 a celldl:Component, bgf:ElectricalCapacitiveNode ;
  bgf:hasLocation "circ" ;
  bgf:hasSpecies "B" ;
  bgf:hasSymbol "q" ;
  bgf:hasValue "0 C"^^cdt:ucum ;
  bgf:parameterValue [
    bgf:hasValue "0.001 C2/J"^^cdt:ucum ;
    bgf:varName "C"
  ] .

:ID-00000004 a celldl:Connection ;
  celldl:hasSource :ID-00000001 ;
  celldl:hasTarget :ID-00000002 ;
  bgf:hasSource :ID-00000001 ;
  bgf:hasTarget :ID-00000002 .

:ID-00000005 a celldl:Connection ;
  celldl:hasSource :ID-00000002 ;
  celldl:hasTarget :ID-00000003 ;
  bgf:hasSource :ID-00000002 ;
  bgf:hasTarget :ID-00000003 .
]]></metadata><defs id="celldl-svg-definitions"><style id="celldl-svg-stylesheet">svg{font-size:16px}.celldl-Connection{stroke-linejoin:round;fill:none}.celldl-Compartment&gt;rect.compartment{fill:#CCC;opacity:0.6;stroke:#444;rx:10px;ry:10px}.celldl-InterfacePort{fill:red;r:4px}.celldl-Unconnected{fill:red;fill-opacity:0.1;stroke:red;r:4px}.celldl-Connection.bondgraph.arrow { marker-end:url(#connection-end-arrow-bondgraph) }
</style><marker id="connection-end-arrow-bondgraph" viewBox="0 0 5.5 5" class="bondgraph" refX="5" refY="2.5" orient="auto-start-reverse" markerUnits="strokeWidth" markerWidth="4" markerHeight="4">
