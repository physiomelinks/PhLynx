{
  "$schema": "./bio-template.schema.json",
  "schemaVersion": 2,
  "id": "rod-photoreceptor",
  "name": "Rod photoreceptor",
  "description": "A rod on its side: its outer and inner segments, two spaces inside one cell joined by the connecting cilium, which carries the circulating current between them, with membrane on every side to the space round the cell.",
  "author": "PhLynx",
  "license": "CC0-1.0",
  "cells": [
    {
      "id": "rod",
      "label": "Rod",
      "site": false,
      "membrane": {
        "label": "Plasma membrane"
      },
      "skin": {
        "ref": "rod-photoreceptor"
      },
      "facets": [
        {
          "id": "os-upper",
          "label": "Outer segment membrane",
          "edge": "top"
        },
        {
          "id": "is-upper",
          "label": "Inner segment membrane",
          "edge": "top"
        },
        {
          "id": "os-lower",
          "label": "Outer segment membrane",
          "edge": "bottom"
        },
        {
          "id": "is-lower",
          "label": "Inner segment membrane",
          "edge": "bottom"
        },
        {
          "id": "os-tip",
          "label": "Outer segment tip",
          "edge": "left"
        },
        {
          "id": "terminal",
          "label": "Synaptic end",
          "edge": "right"
        }
      ],
      "processes": [
        {
          "id": "cilium",
          "label": "Connecting cilium",
          "between": [
            "outer-segment",
            "inner-segment"
          ]
        }
      ]
    }
  ],
  "compartments": [
    {
      "id": "extracellular",
      "label": "Extracellular space",
      "against": [
        "rod.os-upper",
        "rod.is-upper",
        "rod.os-lower",
        "rod.is-lower",
        "rod.os-tip",
        "rod.terminal"
      ],
      "tone": "sky"
    },
    {
      "id": "outer-segment",
      "label": "Outer segment",
      "in": "rod",
      "against": [
        "rod.os-upper",
        "rod.os-lower",
        "rod.os-tip"
      ],
      "term": "GO:0001750",
      "tone": "violet"
    },
    {
      "id": "inner-segment",
      "label": "Inner segment",
      "in": "rod",
      "against": [
        "rod.is-upper",
        "rod.is-lower",
        "rod.terminal"
      ],
      "term": "GO:0001917",
      "tone": "teal"
    }
  ]
}
